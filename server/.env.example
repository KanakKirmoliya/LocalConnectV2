# =============================================================================
# LocalConnect / NearNest Environment Configuration
# =============================================================================
# NOTE: Never commit actual passwords or connection strings to Git.
# Copy this file to .env and replace the placeholders below.
#
# If your password contains special characters like @, :, /, ?, #, or %,
# encode them using standard URL percent-encoding (e.g. '@' -> '%40', '#' -> '%23').
# =============================================================================

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/NearNest?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
